{
  "name": "@metyatech/docusaurus-download-assets",
  "version": "0.1.1",
  "description": "Docusaurus plugin to make docs/**/assets files downloadable via require/import",
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "webpack",
    "asset",
    "download"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('dist-test',{recursive:true,force:true});\"",
    "prepare": "npm run build",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/tests/download-assets.test.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  },
  "license": "MIT"
}
