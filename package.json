{
  "name": "@metyatech/docusaurus-download-assets",
  "version": "0.2.0",
  "description": "Docusaurus plugin to make docs/**/assets files downloadable via require/import",
  "type": "module",
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "webpack",
    "asset",
    "download"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"import('fs').then(({rmSync})=>{rmSync('dist',{recursive:true,force:true}); rmSync('dist-test',{recursive:true,force:true});});\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "npm run build",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/tests/download-assets.test.js",
    "verify": "npm run format:check && npm run lint && npm run test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/metyatech/docusaurus-download-assets.git"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.23.0"
  },
  "license": "MIT"
}
